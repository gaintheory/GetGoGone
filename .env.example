# GetGoGone environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
#
# Quick start for the password gate:
#   node scripts/set-site-password.mjs 'choose something'
# That writes SITE_PASSWORD and generates SITE_AUTH_COOKIE_SECRET for you.

# ─── Auth (required — the app is unreachable without these) ───────────────────
# The single shared site password. There are no user accounts; anyone with this
# string has full operator access. Not recoverable — if you forget it, set a new one.
SITE_PASSWORD=

# HMAC key that signs the session cookie. Minimum 16 characters; 32 random bytes
# recommended. Generate with:  openssl rand -hex 32
# Changing this immediately signs out every existing session.
SITE_AUTH_COOKIE_SECRET=

# ─── Supabase (required — most screens are empty without it) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AutoDoss Data API (required for live inventory) ─────────────────────────
# Without these the app falls back to demo vehicles and shows a banner saying so.
AUTODOSS_API_URL=
AUTODOSS_API_KEY=
# Verifies inventory-change webhooks from AutoDoss (HMAC-SHA256 over the raw body).
AUTODOSS_WEBHOOK_SECRET=

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Absolute base used to build per-vehicle landing page links in campaigns.
# Without it, destination URLs are relative and attribution breaks off-site.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Local AI services (optional; these are the defaults) ────────────────────
# Both must be reachable from the server. They are localhost-only by default, so
# AI text and image generation do not work in a deployed environment as-is.
LOCAL_OLLAMA_URL=http://localhost:11434
LOCAL_TEXT_MODEL=llama3.1:8b
AI_TIMEOUT_MS=20000
COMFYUI_URL=http://localhost:8188

# ─── Misc ────────────────────────────────────────────────────────────────────
# Name given to the auto-created dealership when none exists.
GETGOGONE_DEFAULT_DEALERSHIP_NAME=Right Price Auto Sales

# ─── Ad platform / video credentials ─────────────────────────────────────────
# Deliberately left blank. There is no real publishing or video rendering client
# in the codebase. Setting any of these makes the corresponding route return 501
# rather than fabricate a result. See docs/INTEGRATIONS.md.
#
# NEVER use a NEXT_PUBLIC_ prefix for these — Next.js inlines NEXT_PUBLIC_* into
# the browser bundle, which would publish your ad token to every visitor.
#
# META_ADS_TOKEN=
# GOOGLE_ADS_TOKEN=
# GOOGLE_BUSINESS_TOKEN=
# GOOGLE_VEO_API_KEY=
# GOOGLE_OMNI_API_KEY=
